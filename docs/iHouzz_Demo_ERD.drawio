<mxfile host="app.diagrams.net" agent="PinkWindy" pages="2">
  <diagram id="ERD_iHouzz_demo" name="iHouzz Demo — ERD (json-server)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;iHouzz Demo — ERD&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nguồn: ihouzz-demo/db.json + mediaLibraryApi.js&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="40" as="geometry" />
        </mxCell>
        <!-- pos -->
        <mxCell id="tbl_pos" value="&lt;b&gt;pos&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Chi nhánh POS&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK (string)&lt;br/&gt;name&lt;br/&gt;manager&lt;br/&gt;status&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="130" as="geometry" />
        </mxCell>
        <!-- users -->
        <mxCell id="tbl_users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Nhân sự (IAM demo)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK&lt;br/&gt;name&lt;br/&gt;email&lt;br/&gt;phone&lt;br/&gt;role&lt;br/&gt;status&lt;br/&gt;&lt;b&gt;pos_id&lt;/b&gt; FK → pos.id&lt;br/&gt;pos_name (denormalized)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="220" height="200" as="geometry" />
        </mxCell>
        <!-- properties -->
        <mxCell id="tbl_properties" value="&lt;b&gt;properties&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Tài sản (kho Lv1)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK (LS-#####)&lt;br/&gt;address, district, ward…&lt;br/&gt;type, propertyType&lt;br/&gt;price, priceUnit, price_display&lt;br/&gt;area, bedrooms, bathrooms…&lt;br/&gt;level1_status, level2_status&lt;br/&gt;warehouse_type&lt;br/&gt;images[] (JSON)&lt;br/&gt;&lt;b&gt;createdBy_id&lt;/b&gt; FK → users.id&lt;br/&gt;createdBy (tên)&lt;br/&gt;&lt;b&gt;pos_id&lt;/b&gt; FK → pos.id&lt;br/&gt;pos_name, pos_manager&lt;br/&gt;rejected_reason, approved_at…&lt;br/&gt;pending_update_payload, update_*&lt;br/&gt;unsource* fields&lt;br/&gt;createdAt, updatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="260" height="340" as="geometry" />
        </mxCell>
        <!-- listings -->
        <mxCell id="tbl_listings" value="&lt;b&gt;listings&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Tin đăng (Lv2)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK (LT-#####)&lt;br/&gt;&lt;b&gt;property_id&lt;/b&gt; FK → properties.id&lt;br/&gt;title, description&lt;br/&gt;contact_phone&lt;br/&gt;images[], videos[]&lt;br/&gt;mediaLibraryIds[]&lt;br/&gt;listing_status&lt;br/&gt;&lt;b&gt;createdBy_id&lt;/b&gt; FK → users.id&lt;br/&gt;createdBy&lt;br/&gt;approvedBy*, rejectedBy*&lt;br/&gt;rejection_note, unlist_*&lt;br/&gt;createdAt, updatedAt, expiredAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="240" height="300" as="geometry" />
        </mxCell>
        <!-- mediaLibrary -->
        <mxCell id="tbl_media" value="&lt;b&gt;mediaLibrary&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Media theo tin / tài sản&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK (json-server)&lt;br/&gt;&lt;b&gt;listingId&lt;/b&gt; FK → listings.id&lt;br/&gt;&lt;b&gt;property_id&lt;/b&gt; FK → properties.id&lt;br/&gt;kind (image|video)&lt;br/&gt;source, url&lt;br/&gt;fileName, mimeType, fileSize&lt;br/&gt;createdBy_id → users.id&lt;br/&gt;createdAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="220" height="260" as="geometry" />
        </mxCell>
        <!-- logs -->
        <mxCell id="tbl_logs" value="&lt;b&gt;logs&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Audit log đơn giản (demo)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK&lt;br/&gt;timestamp&lt;br/&gt;action (text)&lt;br/&gt;entityId (polymorphic: LS-*, LT-*, user id…)&lt;br/&gt;user (tên hiển thị)&lt;br/&gt;+ các field bổ sung tùy feature&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="240" height="180" as="geometry" />
        </mxCell>
        <!-- notifications -->
        <mxCell id="tbl_notifications" value="&lt;b&gt;notifications&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Thông báo in-app (ghi DB)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;id&lt;/b&gt; PK&lt;br/&gt;propertyId → properties.id&lt;br/&gt;listingId (optional)&lt;br/&gt;recipient (tên, không FK chặt)&lt;br/&gt;message, type&lt;br/&gt;createdAt, isRead&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="760" width="220" height="200" as="geometry" />
        </mxCell>
        <!-- status_history -->
        <mxCell id="tbl_status" value="&lt;b&gt;status_history&lt;/b&gt;&lt;hr/&gt;&lt;font size=&quot;1&quot; face=&quot;Verdana&quot;&gt;&lt;i&gt;Dự phòng SRS&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Hiện tại mảng &lt;b&gt;rỗng&lt;/b&gt; trong db.json.&lt;br/&gt;Có thể mở rộng: property_id, action, created_at, reason…&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="760" width="220" height="160" as="geometry" />
        </mxCell>
