  </diagram>
  <diagram id="erd_dd" name="02 — Data dictionary &amp; chuẩn hóa">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_p2" value="&lt;b&gt;Trang 2 — Data dictionary &amp; ghi chú chuẩn hóa&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Dùng khi viết DDL / migration từ prototype&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t_dd" value="&lt;b&gt;Từ điển dữ liệu — properties (59 keys gộp từ db.json)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27;&gt;&lt;b&gt;PK&lt;/b&gt; id | &lt;b&gt;FK&lt;/b&gt; createdBy_id→users, pos_id→pos&lt;br/&gt;&lt;b&gt;Địa chỉ&lt;/b&gt; address, district, ward, futureWard, propertyCode&lt;br/&gt;&lt;b&gt;Giá &amp;amp; diện tích&lt;/b&gt; price, priceUnit, price_display, area, width, length&lt;br/&gt;&lt;b&gt;Công trình&lt;/b&gt; type, propertyType, bedrooms, bathrooms, floor, direction, road_width&lt;br/&gt;&lt;b&gt;Pháp lý &amp;amp; mô tả&lt;/b&gt; legal | legalStatus, condition, source, furniture, description, images[]&lt;br/&gt;&lt;b&gt;L1 Kho&lt;/b&gt; level1_status, statusLv1, warehouse_type, rejection_reason, rejected_reason, rejected_at&lt;br/&gt;&lt;b&gt;L2 Tin&lt;/b&gt; level2_status, statusLv2&lt;br/&gt;&lt;b&gt;POS snapshot&lt;/b&gt; pos_name, pos_manager, approvedBy, approvedAt | approved_at&lt;br/&gt;&lt;b&gt;Unsource&lt;/b&gt; unsource_note, unsourceRequestedAt/By, unsourceApprovedAt/By&lt;br/&gt;&lt;b&gt;Update workflow&lt;/b&gt; pending_update_payload, update_request_status, update_requested_at/by/_id&lt;br/&gt;update_request_note, update_rejected_at/by, update_rejection_reason&lt;br/&gt;&lt;b&gt;Audit&lt;/b&gt; createdAt, updatedAt, createdBy (denorm)&lt;br/&gt;&lt;/font&gt;&lt;hr/&gt;&lt;b&gt;listings (26 keys)&lt;/b&gt;&lt;br/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27;&gt;PK id | FK property_id, createdBy_id&lt;br/&gt;title, description, contact_phone, images[], videos[]&lt;br/&gt;listing_status, approved*, rejected*, prev_rejection_note&lt;br/&gt;unlist_*, approvedUnlist*&lt;br/&gt;createdAt, updatedAt, expiredAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#ffffff;strokeColor=#0047AB;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="540" height="540" as="geometry" />
        </mxCell>
        <mxCell id="t_dd2" value="&lt;b&gt;users (8) · pos (4) · notifications (7)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27;&gt;&lt;b&gt;users:&lt;/b&gt; id, name, email, phone?, role, status, pos_id, pos_name&lt;br/&gt;&lt;b&gt;pos:&lt;/b&gt; id, name, manager, status&lt;br/&gt;&lt;b&gt;notifications:&lt;/b&gt; id, propertyId, recipient, message, type, createdAt, isRead&lt;/font&gt;&lt;hr/&gt;&lt;b&gt;logs (tối đa 11 keys / bản ghi)&lt;/b&gt;&lt;br/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27;&gt;id, timestamp, action, entityId, user&lt;br/&gt;reason?, changesPreview[], changes[] {field, old?, new}&lt;br/&gt;approvalKind?, approver?, changedAt?&lt;/font&gt;&lt;hr/&gt;&lt;b&gt;mediaLibrary&lt;/b&gt; (chưa có bản ghi mẫu trong db — schema từ code POST)&lt;br/&gt;listingId, property_id, kind, source, url, fileName, mimeType?, fileSize?, createdAt, createdBy, createdBy_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#f8fbff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="110" width="520" height="420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="erd_br" name="03 — Traceability Feature → Entity">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_p3" value="&lt;b&gt;Trang 3 — Traceability Feature → Entity / Trường dữ liệu&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t_br" value="&lt;b&gt;Ánh xạ Feature demo → thực thể (ITBA traceability)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;F2&lt;/b&gt; Tạo / cập nhật tài sản → &lt;b&gt;properties&lt;/b&gt; (+ pending_update_payload, update_*); logs F2/F3&amp;#xa;&lt;b&gt;F3&lt;/b&gt; Duyệt kho POS → properties.warehouse_type, level1_status, approved*; notifications; logs&amp;#xa;&lt;b&gt;F4&lt;/b&gt; Soạn tin → &lt;b&gt;listings&lt;/b&gt; + POST &lt;b&gt;mediaLibrary&lt;/b&gt; (mediaLibraryIds trên FE)&amp;#xa;&lt;b&gt;F5 / F7&lt;/b&gt; Duyệt niêm yết / gỡ tin → listings.* ; đồng bộ properties.level2_status (BR-005 auto-sync)&amp;#xa;&lt;b&gt;F8&lt;/b&gt; Gỡ nguồn → properties.unsource* ; cascade listings ; BR-010 chặn khi đang niêm yết&amp;#xa;&lt;b&gt;F9&lt;/b&gt; Giám sát kho → đọc properties (masking theo pos_id, BR-013)&amp;#xa;&lt;b&gt;F10&lt;/b&gt; IAM → &lt;b&gt;users&lt;/b&gt;, &lt;b&gt;pos&lt;/b&gt; ; ma trận quyền hiện lưu localStorage (ngoài ERD — cần bảng role_permission khi production)&amp;#xa;&lt;b&gt;F11&lt;/b&gt; Export CSV → đọc &lt;b&gt;logs&lt;/b&gt;&amp;#xa;&lt;b&gt;F12&lt;/b&gt; Dashboard → aggregate properties + listings (read-only)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e8f4ff;strokeColor=#0047AB;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1100" height="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
