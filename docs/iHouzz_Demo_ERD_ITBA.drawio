  <diagram id="erd_main" name="01 — ERD tổng thể (logical)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_p1" value="&lt;b&gt;iHouzz Demo — ERD Logical (json-server)&lt;/b&gt;&lt;br/&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Nguồn: db.json + src/utils/mediaLibraryApi.js · Thực thể = resource REST&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t_pos" value="&lt;b&gt;pos (Chi nhánh)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK — string (json-server)&amp;#xa;name&amp;#xa;manager&amp;#xa;status (active | inactive)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="220" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t_users" value="&lt;b&gt;users (IAM / nhân sự)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK — string (u001, u_admin…)&amp;#xa;name, email, phone?&amp;#xa;role (sales | pos_manager | marketing | admin)&amp;#xa;status&amp;#xa;&lt;b&gt;pos_id&lt;/b&gt; FK → pos.id (nullable: MKT/Admin)&amp;#xa;pos_name &lt;i&gt;(denormalized)&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="280" height="240" as="geometry" />
        </mxCell>
        <mxCell id="t_prop" value="&lt;b&gt;properties (Tài sản — Kho / Level 1)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK — LS-#####&amp;#xa;&lt;b&gt;createdBy_id&lt;/b&gt; FK → users.id&amp;#xa;&lt;b&gt;pos_id&lt;/b&gt; FK → pos.id (number | string trong demo)&amp;#xa;— Địa chỉ &amp; mã —&amp;#xa;address, district, ward, futureWard?, propertyCode?&amp;#xa;— Đặc tả BĐS —&amp;#xa;type, propertyType?, price, priceUnit, price_display&amp;#xa;area, width, length, bedrooms, bathrooms, floor&amp;#xa;direction, road_width, legal | legalStatus?, condition&amp;#xa;source, furniture, description?, images[]&amp;#xa;— Trạng thái 2 tầng (song song statusLv*) —&amp;#xa;level1_status, statusLv1, warehouse_type&amp;#xa;level2_status, statusLv2&amp;#xa;rejection_reason / rejected_reason, rejected_at&amp;#xa;approvedAt | approved_at, approvedBy, pos_manager&amp;#xa;— Gỡ nguồn (F8) —&amp;#xa;unsource_note, unsourceRequestedAt / By&amp;#xa;unsourceApprovedAt / By&amp;#xa;— Cập nhật chờ duyệt (F2 / F3) —&amp;#xa;pending_update_payload?, update_request_*&amp;#xa;update_rejected_*&amp;#xa;createdAt, updatedAt&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="380" height="580" as="geometry" />
        </mxCell>
        <mxCell id="t_list" value="&lt;b&gt;listings (Tin đăng — Level 2)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK — LT-#####&amp;#xa;&lt;b&gt;property_id&lt;/b&gt; FK → properties.id&amp;#xa;&lt;b&gt;createdBy_id&lt;/b&gt; FK → users.id&amp;#xa;title, description, contact_phone&amp;#xa;images[], videos[]&amp;#xa;listing_status&amp;#xa;approvedBy, approvedBy_id, approvedAt&amp;#xa;rejectedBy, rejectedBy_id, rejectedAt, rejection_note&amp;#xa;prev_rejection_note?&amp;#xa;unlist_reason, unlist_note, unlistRequestedAt&amp;#xa;approvedUnlistBy?, approvedUnlistAt?&amp;#xa;createdAt, updatedAt, expiredAt&amp;#xa;&lt;i&gt;FE có thể gửi kèm mediaLibraryIds[]&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="420" width="340" height="420" as="geometry" />
        </mxCell>
        <mxCell id="t_media" value="&lt;b&gt;mediaLibrary (File / URL theo tin)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK (json-server sinh)&amp;#xa;&lt;b&gt;listingId&lt;/b&gt; FK → listings.id&amp;#xa;property_id FK → properties.id (optional)&amp;#xa;kind (image | video), source (upload | url)&amp;#xa;url, fileName, mimeType?, fileSize?&amp;#xa;createdAt, createdBy, createdBy_id&amp;#xa;&lt;i&gt;Schema theo mediaLibraryApi.js — persistMediaItems&lt;/i&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="440" width="300" height="340" as="geometry" />
        </mxCell>
        <mxCell id="t_logs" value="&lt;b&gt;logs (Audit trail — bản ghi đa hình)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK&amp;#xa;timestamp&amp;#xa;action (text, prefix [F#])&amp;#xa;&lt;b&gt;entityId&lt;/b&gt; &lt;i&gt;polymorphic&lt;/i&gt; (LS-*, LT-*, u*, pos id, SYSTEM)&amp;#xa;user (tên hiển thị)&amp;#xa;reason?, changesPreview[], changes[]&amp;#xa;approvalKind?, approver?, changedAt?&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="400" height="280" as="geometry" />
        </mxCell>
        <mxCell id="t_notif" value="&lt;b&gt;notifications (In-app)&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;b&gt;id&lt;/b&gt; PK&amp;#xa;propertyId → properties.id&amp;#xa;recipient (tên, không FK cứng)&amp;#xa;message, type, createdAt, isRead&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="1020" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="t_sh" value="&lt;b&gt;status_history&lt;/b&gt;&lt;hr/&gt;&lt;font face=&#x27;Consolas&#x27; size=&#x27;1&#x27; color=&#x27;#333333&#x27;&gt;&lt;i&gt;Mảng rỗng trong db.json hiện tại&lt;/i&gt;&amp;#xa;Dự phòng SRS: property_id, from_status,&amp;#xa;to_status, actor_id, reason, created_at…&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="1020" width="300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n_poly" value="ITBA ghi chú:&amp;#xa;entityId trong logs là tham chiếu lỏng (text).&amp;#xa;Production: audit_lines + FK hoặc JSONB chuẩn." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fffacd;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="130" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="n_posid" value="pos.id trong JSON là string &quot;1&quot;.&amp;#xa;properties.pos_id đôi khi là number — chuẩn hóa khi lên DB thật." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fffacd;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1240" y="290" width="300" height="100" as="geometry" />
        </mxCell>
